<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/radius_0_25x" />
            <solid android:color="?progressTrack" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/radius_0_25x" />
                <solid android:color="?progressIndicator" />
            </shape>
        </clip>
    </item>
</layer-list>
