{
  "type": "container-flex",
  "direction": "row",
  "variables": {
    "cycle_day_is_pregnancy": {
      "OR": [
        "${cycle_day_is_active_pregnancy}",
        "${cycle_day_is_finished_pregnancy}"
      ]
    },
    "cycle_day_is_future_date": {
      "GT": [
        "${cycle_day_date}",
        {
          "CURRENT_DATE": []
        }
      ]
    },
    "cycle_day_is_today": {
      "EQ": [
        "${cycle_day_date}",
        {
          "CURRENT_DATE": []
        }
      ]
    },
    "cycle_day_symptoms_enabled": {
      "NOT": [
        "${cycle_day_is_future_date}"
      ]
    },
    "cycle_day_sex_enabled": {
      "NOT": [
        "${cycle_day_is_future_date}"
      ]
    },
    "cycle_day_periscore_enabled": "${cycle_day_is_today}",
    "cycle_day_test_enabled": {
      "NOT": [
        "${cycle_day_is_future_date}"
      ]
    },
    "cycle_day_weight_enabled": {
      "NOT": [
        "${cycle_day_is_future_date}"
      ]
    },
    "cycle_day_symptoms_alpha": {
      "IF": [
        "${cycle_day_symptoms_enabled}",
        {
          "type": "double",
          "value": 1
        },
        {
          "type": "double",
          "value": 0.5
        }
      ]
    },
    "cycle_day_sex_alpha": {
      "IF": [
        "${cycle_day_sex_enabled}",
        {
          "type": "double",
          "value": 1
        },
        {
          "type": "double",
          "value": 0.5
        }
      ]
    },
    "cycle_day_periscore_alpha": {
      "IF": [
        "${cycle_day_periscore_enabled}",
        {
          "type": "double",
          "value": 1
        },
        {
          "type": "double",
          "value": 0.5
        }
      ]
    },
    "cycle_day_test_alpha": {
      "IF": [
        "${cycle_day_test_enabled}",
        {
          "type": "double",
          "value": 1
        },
        {
          "type": "double",
          "value": 0.5
        }
      ]
    },
    "cycle_day_weight_alpha": {
      "IF": [
        "${cycle_day_weight_enabled}",
        {
          "type": "double",
          "value": 1
        },
        {
          "type": "double",
          "value": 0.5
        }
      ]
    },
    "cycle_day_main_action_url": {
      "TO_URL": [
        {
          "type": "string",
          "icu": true,
          "icu_calendar": "gregorian",
          "value": "floperiodtracker://edit_cycles?date={cycle_day_date,date,yyyy-MM-dd}&log_period={cycle_day_log_period}"
        }
      ]
    },
    "cycle_day_symptoms_url": {
      "TO_URL": [
        {
          "type": "string",
          "icu": true,
          "icu_calendar": "gregorian",
          "value": "floperiodtracker://symptoms?date={cycle_day_date,date,yyyy-MM-dd}"
        }
      ]
    },
    "cycle_day_sex_url": {
      "TO_URL": [
        {
          "type": "string",
          "icu": true,
          "icu_calendar": "gregorian",
          "value": "floperiodtracker://symptoms?style=compact&categories=sex&date={cycle_day_date,date,yyyy-MM-dd}"
        }
      ]
    },
    "cycle_day_test_url": {
      "TO_URL": [
        {
          "type": "string",
          "icu": true,
          "icu_calendar": "gregorian",
          "value": "floperiodtracker://symptoms?categories=ovulation,pregnancy_test&style=compact&date={cycle_day_date,date,yyyy-MM-dd}"
        }
      ]
    },
    "cycle_day_details_url": {
      "TO_URL": [
        {
          "type": "string",
          "icu": true,
          "icu_calendar": "gregorian",
          "value": "floperiodtracker://pregnancy-details?date={cycle_day_date,date,yyyy-MM-dd}"
        }
      ]
    },
    "cycle_day_settings_url": {
      "TO_URL": [
        {
          "type": "string",
          "icu": true,
          "icu_calendar": "gregorian",
          "value": "floperiodtracker://pregnancy-settings?date={cycle_day_date,date,yyyy-MM-dd}"
        }
      ]
    },
    "cycle_day_weight_url": {
      "TO_URL": [
        {
          "type": "string",
          "icu": true,
          "icu_calendar": "gregorian",
          "value": "floperiodtracker://symptoms?categories=weight&style=compact&date={cycle_day_date,date,yyyy-MM-dd}"
        }
      ]
    },
    "cycle_day_peri_mode": {
      "AND": [
        {
          "EQ": [
            "${aim}",
            {
              "type": "string",
              "value": "track"
            }
          ]
        },
        {
          "EQ": [
            "${subaim}",
            {
              "type": "string",
              "value": "perimenopause"
            }
          ]
        }
      ]
    },
    "cycle_day_sex_visible": {
      "AND": [
        {
          "DEFINED": [
            "${age}"
          ]
        },
        {
          "GTE": [
            "${age}",
            {
              "type": "int",
              "value": 18
            }
          ]
        },
        {
          "NOT": [
            "${cycle_day_peri_mode}"
          ]
        }
      ]
    },
    "cycle_day_periscore_visible": {
      "AND": [
        "${cycle_day_peri_mode}",
        {
          "NOT": [
            "${cycle_day_is_pregnancy}"
          ]
        }
      ]
    },
    "cycle_day_test_visible": {
      "AND": [
        {
          "EQ": [
            "${aim}",
            {
              "type": "string",
              "value": "ttc"
            }
          ]
        },
        {
          "NOT": [
            "${cycle_day_is_pregnancy}"
          ]
        }
      ]
    }
  },
  "children": [
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visible": "${cycle_day_is_period_day}",
      "visibility_animation": {
        "enter": [
          "transition.none"
        ],
        "exit": [
          "transition.none"
        ]
      },
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_period_edit_solid",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_edit_period_label}",
            "identifier": "cycle_day_edit_period_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "${cycle_day_main_action_url}"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_edit_period",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "accent",
            "button_size": "medium",
            "drop_shadow": "shadow.level3",
            "$style:foreground_color": "color.foreground.primaryWhite"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_edit_period_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center"
          }
        }
      ]
    },
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visible": "${cycle_day_is_regular_day}",
      "visibility_animation": {
        "enter": [
          "transition.none"
        ],
        "exit": [
          "transition.none"
        ]
      },
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_period_length_stroke",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_log_period_label}",
            "identifier": "cycle_day_log_period_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "${cycle_day_main_action_url}"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_log_period",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "accent",
            "button_size": "medium",
            "drop_shadow": "shadow.level3",
            "$style:foreground_color": "color.foreground.primaryWhite"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_log_period_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center"
          }
        }
      ]
    },
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visible": "${cycle_day_is_active_pregnancy}",
      "visibility_animation": {
        "enter": [
          "transition.none"
        ],
        "exit": [
          "transition.none"
        ]
      },
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_baby_stroke",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_details_label}",
            "identifier": "cycle_day_details_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "${cycle_day_details_url}"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_details",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "accent",
            "button_size": "medium",
            "drop_shadow": "shadow.level3",
            "$style:foreground_color": "color.foreground.primaryWhite"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_details_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center"
          }
        }
      ]
    },
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visible": "${cycle_day_is_finished_pregnancy}",
      "visibility_animation": {
        "enter": [
          "transition.none"
        ],
        "exit": [
          "transition.none"
        ]
      },
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_settings_stroke",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_settings_label}",
            "identifier": "cycle_day_settings_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "${cycle_day_settings_url}"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_settings",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "contrast_white",
            "button_size": "medium",
            "drop_shadow": "shadow.level3"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_settings_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center"
          }
        }
      ]
    },
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visibility_animation": {
        "enter": [
          "transition.none"
        ],
        "exit": [
          "transition.none"
        ]
      },
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_add_clear",
          "enabled": "${cycle_day_symptoms_enabled}",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_symptoms_label}",
            "identifier": "cycle_day_symptoms_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "${cycle_day_symptoms_url}"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_symptoms",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "contrast_white",
            "button_size": "medium",
            "drop_shadow": "shadow.level3"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_symptoms_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center",
            "alpha": "${cycle_day_symptoms_alpha}"
          }
        }
      ]
    },
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visible": "${cycle_day_sex_visible}",
      "visibility_animation": {
        "enter": [
          "transition.none"
        ],
        "exit": [
          "transition.none"
        ]
      },
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_heart_stroke",
          "enabled": "${cycle_day_sex_enabled}",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_sex_label}",
            "identifier": "cycle_day_sex_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "${cycle_day_sex_url}"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_sex",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "contrast_white",
            "button_size": "medium",
            "drop_shadow": "shadow.level3"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_sex_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center",
            "alpha": "${cycle_day_sex_alpha}"
          }
        }
      ]
    },
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visible": "${cycle_day_is_pregnancy}",
      "visibility_animation": {
        "enter": [
          "transition.none"
        ],
        "exit": [
          "transition.none"
        ]
      },
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_weight_stroke",
          "enabled": "${cycle_day_weight_enabled}",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_weight_label}",
            "identifier": "cycle_day_weight_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "${cycle_day_weight_url}"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_weight",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "contrast_white",
            "button_size": "medium",
            "drop_shadow": "shadow.level3"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_weight_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center",
            "alpha": "${cycle_day_weight_alpha}"
          }
        }
      ]
    },
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visible": "${cycle_day_periscore_visible}",
      "visibility_animation": {
        "enter": [
          "transition.none"
        ],
        "exit": [
          "transition.none"
        ]
      },
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_signal_level_four_solid",
          "enabled": "${cycle_day_periscore_enabled}",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_periscore_label}",
            "identifier": "cycle_day_periscore_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "floperiodtracker://va?dialogId=400_030"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_periscore",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "contrast_white",
            "button_size": "medium",
            "drop_shadow": "shadow.level3",
            "$style:foreground_color": "color.foreground.minor"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_periscore_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center",
            "alpha": "${cycle_day_periscore_alpha}"
          }
        }
      ]
    },
    {
      "type": "container-flex",
      "direction": "column",
      "align_items": "center",
      "visible": "${cycle_day_test_visible}",
      "layout": {
        "flex_item": {
          "flex_grow": 1
        }
      },
      "children": [
        {
          "type": "button",
          "icon": "medium_ovulation_test_stroke",
          "enabled": "${cycle_day_test_enabled}",
          "accessibility": {
            "state": "on",
            "label": "${cycle_day_test_label}",
            "identifier": "cycle_day_test_button"
          },
          "action_click": {
            "type": "composite",
            "children": [
              {
                "type": "open_url",
                "url": "${cycle_day_test_url}"
              },
              {
                "type": "activity_log",
                "analytics_data": {
                  "screen": "today",
                  "source": "cycle_day",
                  "item_id": "button_test",
                  "day_id": "${cycle_day_date}"
                }
              }
            ]
          },
          "style": {
            "button_fill": "contrast_white",
            "button_size": "medium",
            "drop_shadow": "shadow.level3"
          },
          "layout": {
            "margin_bottom": 4
          }
        },
        {
          "type": "text",
          "text": "${cycle_day_test_label}",
          "accessibility": {
            "state": "off"
          },
          "style": {
            "$style:foreground_color": "color.foreground.primary",
            "$style:typography": "typography.footnote.regular",
            "text_align": "center",
            "alpha": "${cycle_day_test_alpha}"
          }
        }
      ]
    }
  ]
}
