                            "blockName": "CSS | Pricing Block Android",
                            "css": "\n/* --- Highlights --- */\n.pba {\n  --product-highlight-color: #ff5a7d;\n}\n  \n.pba .pc__product[aria-pressed=false] {\n  filter: grayscale(1);\n  background-color: rgba(0,0,0, 0.2) !important;\n  opacity: 0.6;\n}\n.pba .pc__product[aria-pressed=false] > .blockGroup {\n  background-color: white !important;\n}\n.pba .pc__product + .pc__product {\n  margin-top: 8px;\n}\n.pba .pc__product \n.pba .pc__product[aria-pressed=true],\n.pba .pc__product:focus,\n.pba .pc__product::focus {\n  -webkit-tap-highlight-color: rgba(255, 255, 255, 0) !important; \n  -webkit-focus-ring-color: rgba(255, 255, 255, 0) !important; \n  outline: none;\n}\n        \n/* --- Main Styles --- */\n.pba .pc__product_toggle {\n  text-align: left;\n}\n\n.pba .pc__product_badge {\n  font-size: 11px;\n  font-weight: 500;\n  line-height: 16px;\n  margin: 0 0 1px 0;\n  padding: 2px 0;\n  text-transform: uppercase;\n}\n\n.pba .pc__product_price_name {\n  color: #000;\n  font-size: 24px;\n  font-weight: 700;\n  line-height: 1.3;\n  margin: 0;\n  padding: 0;\n  width: auto;\n}\n\n.pba .pc__product_converted_price {\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1.528;\n  margin: 0;\n  padding: 0;\n  width: auto;\n  text-align: left\n}\n\n.pba .pc__product_converted_price--end {\n  font-weight: 700;\n  line-height: 1;\n  margin: 0;\n  padding: 0;\n  width: auto;\n}\n\n.pba .pc__product_price_start {\n  align-items: flex-start;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  justify-content: flex-start;\n}\n\n.pba .pc__product_price_end {\n  align-items: flex-end;\n}\n\n\n.pba .pc__product_pricing {\n  align-items: center;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: 1fr max-content;\n  justify-content: flex-start;\n}\n\n.pba .pc__product_info {\n  background-color: #ffedf2;\n  border-radius: 0 0 10px 10px;\n  color: rgba(0,0,0,0.6);\n  display: flex;\n  gap: 8px;\n  padding: 14px 16px;\n}\n\n.pba .pc__product {\n  background-color: var(--product-highlight-color);\n  background-position: center top;\n  background-size: 220% auto;\n  border-radius: 11px;\n  display: flex;\n  flex-flow: column;\n  overflow: hidden;\n  padding: 2px;\n  width: 100%;\n}\n\n.pba .pc__product--secondary {\n  width: 100%;\n  display: flex;\n  padding: 2px;\n  flex-flow: column;\n  overflow: hidden;\n  border-radius: 12px;\n  background-size: 220% auto;\n  background-color: var(--product-highlight-color);\n  background-position: center top;\n}\n\n\n.pba .pc__product--secondary .pc__product_price_name {\n  color: #000;\n  width: auto;\n  margin: 0;\n  padding: 0;\n  font-size: 13px;\n  font-weight: 700;\n  line-height: 1.54;\n}\n\n.pba .pc__product--secondary .pc__product_info {\n  gap: 8px;\n  color: rgba(0,0,0,0.6);\n  display: flex;\n  padding: 14px 16px;\n  border-radius: 10px;\n  background-color: #ffedf2;\n}\n\n.pba .pc__product--secondary .pc__product_pricing {\n  gap: 8px;\n  display: grid;\n  align-items: center;\n  justify-content: flex-start;\n  grid-template-columns: 1fr max-content;\n}\n\n.pba .pc__product--secondary .pc__product_converted_price {\n  width: auto;\n  margin: 0;\n  padding: 0;\n  font-weight: 700;\n  line-height: 1;\n}\n.pba .pc__product--secondary .pc__product_price_start {\n  gap: 2px;\n  display: flex;\n  align-items: flex-start;\n  flex-direction: column;\n  justify-content: flex-start;\n}\n.pba .pc__product--secondary .pc__product_price_end {\n  align-items: flex-end;\n}\n\n\n.pba .pc__payment_terms {\n  margin-top: 0;\n}\n\n.pba .pc__product_list {\n  gap: 0;\n}\n        "
