<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/crisp_sdk_compose_paddingHorizontal"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include android:id="@id/crisp_sdk_divider" layout="@layout/crisp_sdk_divider_compose" />
    <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="1.0">
        <com.google.android.material.textfield.TextInputLayout android:id="@id/crisp_sdk_compose_input_layout" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" style="@style/Widget.Crisp.SDK.TextInputLayout.Compose">
            <com.google.android.material.textfield.TextInputEditText android:id="@id/crisp_sdk_compose_input_edittext" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@id/crisp_sdk_send" android:visibility="gone" android:contentDescription="@string/crisp_sdk_chat_chat_form_send_hint" app:icon="@drawable/crisp_sdk_send" style="@style/Widget.Crisp.SDK.Button.Filled.Square.Send" />
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/crisp_sdk_compose_buttons_paddingHorizontal">
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@id/crisp_sdk_smiley_button" android:button="@drawable/crisp_sdk_smiley_add" android:contentDescription="@string/crisp_sdk_chat_chat_form_smiley_tooltip" style="@style/Widget.Crisp.SDK.Button.Standard.Compose" />
        <LinearLayout android:id="@id/crisp_sdk_attachment" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent">
            <com.google.android.material.button.MaterialButton android:id="@id/crisp_sdk_attachment_button" android:contentDescription="@string/crisp_sdk_chat_chat_form_attach_tooltip" app:icon="@drawable/crisp_sdk_attachment_add" style="@style/Widget.Crisp.SDK.Button.Standard.Compose" />
            <LinearLayout android:gravity="center_vertical" android:id="@id/crisp_sdk_attachment_progress" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingStart="0.0dp" android:paddingEnd="5.0dp">
                <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@id/crisp_sdk_attachment_progress_indicator" android:indeterminate="true" style="@style/Widget.Crisp.SDK.CircularProgressIndicator" />
                <TextView android:ellipsize="end" android:gravity="center_vertical" android:id="@id/crisp_sdk_attachment_progress_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="80.0dp" android:text="@string/crisp_sdk_chat_chat_form_attach_wait_preparing" android:singleLine="true" style="@style/TextAppearance.Crisp.SDK.LabelMedium.Bold.Primary" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@id/crisp_sdk_feedback_button" android:visibility="gone" android:button="@drawable/crisp_sdk_feedback" android:contentDescription="@string/crisp_sdk_chat_chat_form_feedback_tooltip" style="@style/Widget.Crisp.SDK.Button.Standard.Compose.Feedback" />
        <Space android:visibility="invisible" android:layout_width="0.0dp" android:layout_height="match_parent" android:layout_weight="1.0" />
        <Button android:id="@id/crisp_sdk_branding" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/crisp_sdk_branding" style="@style/Widget.Crisp.SDK.Button.Text.Branding" />
    </LinearLayout>
</LinearLayout>
