<?xml version="1.0" encoding="utf-8"?>
<MotionScene
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition motion:constraintSetEnd="@id/end" motion:constraintSetStart="@id/start" motion:duration="@android:integer/config_mediumAnimTime" motion:motionInterpolator="overshoot" />
    <ConstraintSet android:id="@id/start">
        <Constraint android:id="@id/loading">
            <PropertySet motion:visibilityMode="ignore" />
        </Constraint>
        <Constraint android:id="@id/bumpieFlag">
            <PropertySet motion:visibilityMode="ignore" />
        </Constraint>
        <Constraint android:id="@id/actions">
            <PropertySet android:alpha="1.0" />
        </Constraint>
        <Constraint android:id="@id/tools">
            <Layout android:layout_width="0.0dp" android:layout_height="@dimen/toolsBarSize" motion:layout_constraintBottom_toBottomOf="parent" motion:layout_constraintEnd_toEndOf="parent" motion:layout_constraintStart_toStartOf="parent" />
        </Constraint>
        <Constraint android:id="@id/filters">
            <Layout android:layout_width="0.0dp" android:layout_height="@dimen/toolsBarSize" motion:layout_constraintEnd_toEndOf="parent" motion:layout_constraintStart_toStartOf="parent" motion:layout_constraintTop_toBottomOf="parent" />
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@id/end" motion:deriveConstraintsFrom="@id/start">
        <Constraint android:id="@id/actions">
            <PropertySet android:alpha="0.0" />
        </Constraint>
        <Constraint android:id="@id/tools">
            <Layout android:layout_width="0.0dp" android:layout_height="@dimen/toolsBarSize" motion:layout_constraintEnd_toEndOf="parent" motion:layout_constraintStart_toStartOf="parent" motion:layout_constraintTop_toBottomOf="parent" />
        </Constraint>
        <Constraint android:id="@id/filters">
            <Layout android:layout_width="0.0dp" android:layout_height="@dimen/toolsBarSize" motion:layout_constraintBottom_toBottomOf="parent" motion:layout_constraintEnd_toEndOf="parent" motion:layout_constraintStart_toStartOf="parent" />
        </Constraint>
    </ConstraintSet>
</MotionScene>
