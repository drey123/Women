<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="?colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_enabled="true">
                <shape>
                    <solid android:color="@color/bumpieWidgetCardBackgroundColor" />
                    <corners android:radius="16.0dp" />
                </shape>
            </item>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="@color/bumpieWidgetCardDisabledBackgroundColor" />
                    <corners android:radius="16.0dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
