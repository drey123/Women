<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorBackgroundCard" />
            <stroke android:width="1.0dp" android:color="@color/colorBorderLoyaltyRewardAction" />
            <corners android:radius="@dimen/babycenter.cardView.cornerRadius" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/babycenter.cardView.cornerRadius" />
        </shape>
    </item>
</ripple>
