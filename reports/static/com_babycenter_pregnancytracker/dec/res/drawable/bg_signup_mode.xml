<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/signupModeBackgroundChecked" />
            <stroke android:width="2.0dp" android:color="@color/signupModeBackgroundStrokeChecked" />
            <corners android:radius="@dimen/babycenter.cardView.cornerRadius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.0dp" android:color="@color/signupModeBackgroundStrokeChecked" />
            <corners android:radius="@dimen/babycenter.cardView.cornerRadius" />
        </shape>
    </item>
</selector>
