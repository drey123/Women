<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#a9a9a9" android:endColor="#a9a9a9" android:angle="0.0" android:centerY="0.0" android:centerColor="#a9a9a9" />
            <stroke android:width="1.0px" android:color="#474747" />
            <corners android:radius="8.0dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:startColor="#a9a9a9" android:endColor="#a9a9a9" android:angle="0.0" android:centerY="0.0" android:centerColor="#a9a9a9" />
            <stroke android:width="1.0px" android:color="#474747" />
            <corners android:radius="8.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#ff505050" android:endColor="#ff505050" android:angle="0.0" android:centerY="0.0" android:centerColor="#ff505050" />
            <padding android:bottom="3.0dp" />
            <stroke android:width="1.0px" android:color="#ff000000" />
            <corners android:radius="8.0dp" />
        </shape>
    </item>
</selector>
