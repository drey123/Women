<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#760d15" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="#760d15" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#bd1421" />
            <corners android:radius="8.0dp" />
            <stroke android:width="1.0dp" android:color="#bd1421" />
        </shape>
    </item>
</selector>
