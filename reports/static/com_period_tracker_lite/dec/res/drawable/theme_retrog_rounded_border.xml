<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#55555555" />
            <corners android:radius="3.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#548cbb" android:endColor="#00549a" android:angle="270.0" />
            <corners android:radius="3.0dp" />
            <stroke android:width="1.0dp" android:color="#2e5576" />
        </shape>
    </item>
</selector>
