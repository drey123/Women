<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="0.75dp" android:color="#d8d8d8" />
            <solid android:color="#d8d8d8" />
            <corners android:radius="0.0dp" />
            <padding android:left="2.0dp" android:top="5.0dp" android:right="2.0dp" android:bottom="5.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="0.75dp" android:color="#d8d8d8" />
            <solid android:color="#d8d8d8" />
            <corners android:radius="0.0dp" />
            <padding android:left="2.0dp" android:top="5.0dp" android:right="2.0dp" android:bottom="5.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.75dp" android:color="#e4e4e4" />
            <solid android:color="#ffffff" />
            <corners android:radius="0.0dp" />
            <padding android:left="2.0dp" android:top="5.0dp" android:right="2.0dp" android:bottom="5.0dp" />
        </shape>
    </item>
</selector>
