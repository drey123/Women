<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Alert.Button.Neutral" parent="@style/mdtp_ActionButton.Text">
        <item name="android:textSize">14.0sp</item>
        <item name="android:textColor">@color/new_colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="background">@color/white</item>
        <item name="fontFamily">@font/dpui_roboto_medium</item>
        <item name="rippleColor">@color/colorPrimary</item>
    </style>
    <style name="Alert.Button.Positive" parent="@style/mdtp_ActionButton.Text">
        <item name="android:textSize">14.0sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="background">@color/white</item>
        <item name="fontFamily">@font/dpui_roboto_medium</item>
        <item name="rippleColor">@color/colorPrimary</item>
    </style>
    <style name="Base.Theme.SplashScreen" parent="@style/Base.v27.Theme.SplashScreen" />
    <style name="Base.Theme.SplashScreen.Light" parent="@style/Base.v27.Theme.SplashScreen.Light" />
    <style name="Base.v27.Theme.SplashScreen" parent="@style/Base.v21.Theme.SplashScreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Base.v27.Theme.SplashScreen.Light" parent="@style/Base.v21.Theme.SplashScreen.Light">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="CustomAlertTheme" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="backgroundTint">@color/white</item>
        <item name="buttonBarNegativeButtonStyle">@style/Alert.Button.Neutral</item>
        <item name="buttonBarNeutralButtonStyle">@style/Alert.Button.Neutral</item>
        <item name="buttonBarPositiveButtonStyle">@style/Alert.Button.Positive</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="fontFamily">@font/robotoregular</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title.Text</item>
    </style>
    <style name="MaterialAlertDialog.App.Title.Text" parent="@style/MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="MaterialAppBaseTheme" parent="@style/Theme.Material3.Light.NoActionBar">
        <item name="android:colorBackground">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:actionModeBackground">@color/dark_pink_color</item>
        <item name="android:actionModeCloseDrawable">@drawable/close_button</item>
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:datePickerDialogTheme">@style/MyDatePickerDialogTheme</item>
        <item name="android:windowSharedElementsUseOverlay">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorAccent">@color/new_colorPrimary</item>
        <item name="colorControlHighlight">@color/transparent</item>
        <item name="colorControlNormal">@color/light_gray</item>
        <item name="colorOnSurface">@color/gray</item>
        <item name="colorPrimary">@color/new_colorPrimary</item>
        <item name="colorSecondary">@color/text_field_background</item>
        <item name="materialCardViewStyle">@style/MaterialCardView</item>
        <item name="textInputStyle">@style/TextLabel</item>
        <item name="windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.SampleApp.MainActivity2" parent="@style/Theme.AppCompat.Light.NoActionBar" />
</resources>
