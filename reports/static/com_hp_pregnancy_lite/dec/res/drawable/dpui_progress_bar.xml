<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:height="?progressBarStyle">
        <shape>
            <solid android:color="@color/dpui_progress_bar_color_background" />
            <corners android:radius="2.0dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:height="?progressBarStyle">
        <scale android:scaleWidth="100%">
            <shape>
                <solid android:color="@color/dpui_progress_bar_color_primary" />
                <corners android:radius="2.0dp" />
            </shape>
        </scale>
    </item>
</layer-list>
