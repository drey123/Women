<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/appointments_nav_graph" app:startDestination="@id/appointmentBaseScreen"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/add_appointment_nav_graph" />
    <fragment android:label="AppointmentBaseScreen" android:name="com.hp.pregnancy.lite.me.appointment.AppointmentScreen" android:id="@id/appointmentBaseScreen">
        <argument android:name="appointmentDate" android:defaultValue="" app:argType="string" />
        <argument android:name="subsection" android:defaultValue="" app:argType="string" />
        <deepLink android:id="@id/appointments_deep_link" app:uri="@string/appointments_deeplink_uri" />
        <action android:id="@id/action_navigation_appointment_base_to_add_appointment" app:destination="@id/add_appointment_nav_graph">
            <argument android:name="appointmentViewType" android:defaultValue="Calendar" app:argType="string" />
            <argument android:name="isEditAppointment" android:defaultValue="false" app:argType="boolean" />
            <argument android:name="appointmentDate" android:defaultValue="0L" app:argType="long" />
            <argument android:name="selectedAppointment" android:defaultValue="@null" app:argType="com.hp.pregnancy.model.MyAppointment" app:nullable="true" />
        </action>
    </fragment>
</navigation>
