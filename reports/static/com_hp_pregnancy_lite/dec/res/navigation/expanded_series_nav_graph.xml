<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/expanded_series_nav_graph" app:startDestination="@id/expandedSeriesContainer"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/expanded_article_nav_graph" />
    <include app:graph="@navigation/product_purchase_nav_graph" />
    <include app:graph="@navigation/video_player_nav_graph" />
    <fragment android:label="ExpandedSeries" android:name="com.hp.pregnancy.lite.premium.expandedSeries.ExpandedSeriesContainer" android:id="@id/expandedSeriesContainer">
        <argument android:name="seriesCMSId" android:defaultValue="" app:argType="string" />
        <argument android:name="isFromPremiumScreen" android:defaultValue="false" app:argType="boolean" />
        <argument android:name="carouselTitle" android:defaultValue="" app:argType="string" />
        <argument android:name="parentCmsId" android:defaultValue="" app:argType="string" />
        <argument android:name="isPremium" android:defaultValue="false" app:argType="boolean" />
        <action android:id="@id/action_expandedSeriesContainer_to_expandedArticleContainer" app:destination="@id/expanded_article_nav_graph">
            <argument android:name="articleScreenArg" app:argType="com.philips.hp.cms.model.premiumcontent.ArticleScreenArg" app:nullable="false" />
        </action>
        <action android:id="@id/action_expandedSeriesContainer_to_productPurchasePopupFragment" app:destination="@id/product_purchase_nav_graph" />
        <action android:id="@id/action_expandedSeriesContainer_to_videoAudioPlayerContainer" app:destination="@id/video_player_nav_graph">
            <argument android:name="mediaUri" app:argType="string" />
            <argument android:name="shouldSendMuxAnalytics" app:argType="boolean" />
            <argument android:name="seriesId" app:argType="string" />
            <argument android:name="mediaData" app:argType="com.philips.hp.cms.model.premiumcontent.MediaCarouselItemContent" app:nullable="true" />
            <argument android:name="isFromPremiumScreen" app:argType="boolean" />
        </action>
        <deepLink android:id="@id/subtopic_new_model_deep_link" app:uri="@string/subtopic_new_model_deep_link" />
    </fragment>
</navigation>
