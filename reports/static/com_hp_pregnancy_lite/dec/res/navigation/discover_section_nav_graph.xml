<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/navigation_discover" app:startDestination="@id/discoverFragment"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <fragment android:label="DiscoverFragment" android:name="com.hp.pregnancy.lite.discover.ui.DiscoverFragment" android:id="@id/discoverFragment">
        <action android:id="@id/action_exploreFragment_to_subscriptionPopupFragment" app:destination="@id/product_purchase_nav_graph" />
        <action android:id="@id/action_exploreFragment_to_expanded_series_nav_graph" app:destination="@id/expanded_series_nav_graph">
            <argument android:name="seriesCMSId" app:argType="string" />
            <argument android:name="isFromPremiumScreen" app:argType="boolean" />
            <argument android:name="carouselTitle" app:argType="string" />
            <argument android:name="parentCmsId" app:argType="string" />
            <argument android:name="isPremium" app:argType="boolean" />
        </action>
        <action android:id="@id/action_exploreFragment_to_expanded_article_nav_graph" app:destination="@id/expanded_article_nav_graph">
            <argument android:name="articleScreenArg" app:argType="com.philips.hp.cms.model.premiumcontent.ArticleScreenArg" app:nullable="false" />
        </action>
        <action android:id="@id/action_discoverFragment_to_videoAudioPlayerContainer" app:destination="@id/video_player_nav_graph">
            <argument android:name="mediaUri" app:argType="string" />
            <argument android:name="shouldSendMuxAnalytics" app:argType="boolean" />
            <argument android:name="seriesId" app:argType="string" />
            <argument android:name="mediaData" app:argType="com.philips.hp.cms.model.premiumcontent.MediaCarouselItemContent" app:nullable="true" />
            <argument android:name="isFromPremiumScreen" app:argType="boolean" />
        </action>
        <action android:id="@id/action_discoverFragment_to_weekByWeekContainer" app:destination="@id/week_by_week_nav_graph">
            <argument android:name="weeklyCMSId" android:defaultValue="" app:argType="string" />
            <argument android:name="seriesCMSId" android:defaultValue="" app:argType="string" />
        </action>
        <action android:id="@id/action_discoverFragment_to_searchFragment" app:destination="@id/searchFragment">
            <argument android:name="searchText" android:defaultValue="" app:argType="string" />
        </action>
    </fragment>
    <include app:graph="@navigation/product_purchase_nav_graph" />
    <include app:graph="@navigation/expanded_series_nav_graph" />
    <include app:graph="@navigation/expanded_article_nav_graph" />
    <include app:graph="@navigation/week_by_week_nav_graph" />
    <include app:graph="@navigation/video_player_nav_graph" />
    <fragment android:label="SearchFragment" android:name="com.philips.search.ui.SearchFragment" android:id="@id/searchFragment">
        <argument android:name="searchText" android:defaultValue="" app:argType="string" />
    </fragment>
</navigation>
