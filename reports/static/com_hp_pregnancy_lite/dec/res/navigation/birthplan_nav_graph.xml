<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/birthplan_nav_graph" app:startDestination="@id/birthPlanListScreen"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/product_purchase_nav_graph" />
    <include app:graph="@navigation/upgrade_screen_nav_graph" />
    <fragment android:label="BirthPlanListScreen" android:name="com.hp.pregnancy.lite.me.birthplan.BirthPlanListScreen" android:id="@id/birthPlanListScreen">
        <action android:id="@id/action_birthPlanListScreen_to_birthPlanBaseScreen" app:destination="@id/birthPlanBaseScreen">
            <argument android:name="engCategory" android:defaultValue="" app:argType="string" />
            <argument android:name="localisedCategory" android:defaultValue="" app:argType="string" />
        </action>
        <action android:id="@id/action_birthPlanListScreen_to_myBirthPlanScreen" app:destination="@id/myBirthPlanScreen" />
        <action android:id="@id/action_birthPlanListScreen_to_upgradeScreen" app:destination="@id/upgrade_screen_nav_graph">
            <argument android:name="CallingActivity" android:defaultValue="" app:argType="string" />
            <argument android:name="IapSource" android:defaultValue="" app:argType="string" />
        </action>
        <deepLink android:id="@id/birth_plan_deep_link" app:uri="@string/birthPlan_deeplink_uri" />
        <action android:id="@id/action_birthPlanListScreen_to_product_purchase_nav_graph" app:destination="@id/product_purchase_nav_graph" />
    </fragment>
    <fragment android:label="BirthPlanBaseScreen" android:name="com.hp.pregnancy.lite.me.birthplan.BirthPlanBaseScreen" android:id="@id/birthPlanBaseScreen">
        <argument android:name="engCategory" android:defaultValue="" app:argType="string" />
        <argument android:name="localisedCategory" android:defaultValue="" app:argType="string" />
        <action android:id="@id/action_birthPlanBaseScreen_to_upgradeScreen" app:destination="@id/upgrade_screen_nav_graph">
            <argument android:name="CallingActivity" android:defaultValue="" app:argType="string" />
            <argument android:name="IapSource" android:defaultValue="" app:argType="string" />
        </action>
        <action android:id="@id/action_birthPlanBaseScreen_to_product_purchase_nav_graph" app:destination="@id/product_purchase_nav_graph" />
    </fragment>
    <fragment android:label="MyBirthPlanScreen" android:name="com.hp.pregnancy.lite.me.birthplan.MyBirthPlanScreen" android:id="@id/myBirthPlanScreen" />
</navigation>
