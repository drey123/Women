<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/weekly_images_nav_graph" app:startDestination="@id/weeklyImagesContainerScreen"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/upgrade_screen_nav_graph" />
    <fragment android:label="WeeklyImagesContainerScreen" android:name="com.hp.pregnancy.lite.baby.images.WeeklyImagesContainerScreen" android:id="@id/weeklyImagesContainerScreen">
        <argument android:name="subsection" android:defaultValue="" app:argType="string" />
        <argument android:name="pregnancy_week" android:defaultValue="-1" app:argType="integer" />
        <deepLink android:id="@id/images_deep_link" app:uri="@string/images_deeplink_uri" />
        <action android:id="@id/action_navigation_weekly_images_to_upgrade" app:destination="@id/upgrade_screen_nav_graph">
            <argument android:name="CallingActivity" android:defaultValue="" app:argType="string" />
            <argument android:name="IapSource" android:defaultValue="" app:argType="string" />
        </action>
    </fragment>
</navigation>
