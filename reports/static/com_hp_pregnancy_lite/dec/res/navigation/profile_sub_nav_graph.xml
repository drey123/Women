<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/profile_sub_nav_graph" app:startDestination="@id/profileFragment"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/webscreen_nav_graph" />
    <fragment android:label="ProfileFragment" android:name="com.hp.pregnancy.lite.profile.options.view.ProfileFragmentNew" android:id="@id/profileFragment">
        <deepLink android:id="@id/baby_gender_deeplink" app:uri="@string/profile_deeplink_uri" />
        <argument android:name="subsection" android:defaultValue="" app:argType="string" />
        <action android:id="@id/action_navigation_back_to_today_feed" app:destination="@id/navigation_today" app:popUpTo="@id/navigation_today" />
        <action android:id="@id/action_profileFragment_to_signupActivity" app:destination="@id/signupActivity" />
        <action android:id="@id/action_profileFragment_to_loginActivity" app:destination="@id/loginActivity" />
        <action android:id="@id/action_profileFragment_to_webScreenActivity" app:destination="@id/webscreen_nav_graph">
            <argument android:name="IsFromProfile" android:defaultValue="false" app:argType="boolean" />
            <argument android:name="IsFromMore" android:defaultValue="false" app:argType="boolean" />
            <argument android:name="Heading" app:argType="integer" />
            <argument android:name="Url" app:argType="string" app:nullable="true" />
            <argument android:name="AnalyticsScreen" app:argType="string" />
        </action>
        <action android:id="@id/action_profileFragment_to_aboutUsWebScreenActivity" app:destination="@id/aboutUsWebScreenActivity">
            <argument android:name="IsFromProfile" android:defaultValue="false" app:argType="string" app:nullable="true" />
            <argument android:name="IsFromMore" android:defaultValue="false" app:argType="string" app:nullable="true" />
            <argument android:name="Heading" app:argType="integer" />
            <argument android:name="Url" app:argType="string" app:nullable="true" />
            <argument android:name="AnalyticsScreenKey" app:argType="string" />
        </action>
        <action android:id="@id/action_profileFragment_to_coRegExpandedFragmentPregnancy" app:destination="@id/coRegExpandedFragmentPregnancy" />
        <action android:id="@id/action_profileFragment_to_deleteDataAccountFragment" app:destination="@id/deleteDataAccountFragment" />
        <action android:id="@id/action_profileFragment_to_emailPreferenceFragment" app:destination="@id/emailPreferenceFragment" />
        <action android:id="@id/action_profileFragment_to_saved_coupon_list_nav_graph" app:destination="@id/saved_coupon_list_nav_graph" />
        <action android:id="@id/action_profileFragment_to_crm_popup_nav_graph" app:destination="@id/crm_popup_nav_graph" />
        <action android:id="@id/action_profileFragment_to_main_navigation" app:destination="@id/navigation_community">
            <argument android:name="load_url" android:defaultValue="" app:argType="string" />
        </action>
        <action android:id="@id/action_profileFragment_to_communityFragment" app:destination="@id/navigation_community">
            <argument android:name="load_url" android:defaultValue="" app:argType="string" />
        </action>
        <action android:id="@id/action_profileFragment_to_communityProfileFragment" app:destination="@id/navigation_community_profile">
            <argument android:name="load_url" android:defaultValue="" app:argType="string" />
        </action>
        <action android:id="@id/action_profileFragment_to_personalisedConsentFragment" app:destination="@id/personalisedConsentFragment" />
    </fragment>
    <activity android:label="SignupActivity" android:name="com.hp.pregnancy.lite.onboarding.SignupActivity" android:id="@id/signupActivity" />
    <activity android:label="LoginActivity" android:name="com.hp.pregnancy.lite.onboarding.LoginActivity" android:id="@id/loginActivity" />
    <activity android:label="AboutUsWebScreenActivity" android:name="com.hp.pregnancy.lite.AboutUsWebScreenActivity" android:id="@id/aboutUsWebScreenActivity">
        <argument android:name="IsFromProfile" android:defaultValue="false" app:argType="string" app:nullable="true" />
        <argument android:name="IsFromMore" android:defaultValue="false" app:argType="string" app:nullable="true" />
        <argument android:name="Heading" app:argType="integer" />
        <argument android:name="Url" app:argType="string" app:nullable="true" />
        <argument android:name="AnalyticsScreenKey" app:argType="string" />
    </activity>
    <fragment android:label="CoRegExpandedFragmentPregnancy" android:name="com.hp.pregnancy.lite.coregistration.CoRegExpandedFragmentPregnancy" android:id="@id/coRegExpandedFragmentPregnancy">
        <argument android:name="adType" app:argType="string" />
    </fragment>
    <fragment android:label="DeleteDataAccountFragment" android:name="com.hp.pregnancy.datacenter.DeleteDataAccountFragment" android:id="@id/deleteDataAccountFragment">
        <action android:id="@id/action_deleteDataAccountFragment_to_communityProfileFragment" app:destination="@id/navigation_community_profile">
            <argument android:name="load_url" android:defaultValue="" app:argType="string" />
        </action>
    </fragment>
    <fragment android:label="PersonalisedConsentFragment" android:name="com.hp.pregnancy.lite.personalisedConsent.PersonalisedConsentFragment" android:id="@id/personalisedConsentFragment" />
    <fragment android:label="EmailPreferenceFragment" android:name="com.hp.pregnancy.lite.profile.options.view.EmailPreferenceFragment" android:id="@id/emailPreferenceFragment">
        <argument android:name="subsection" android:defaultValue="" app:argType="string" />
        <argument android:name="generalConsentStatus" android:defaultValue="" app:argType="string" />
        <argument android:name="personalisedConsentStatus" android:defaultValue="" app:argType="string" />
        <deepLink android:id="@id/email_preferences_deeplink" app:uri="@string/email_preferences_deeplink_uri" />
    </fragment>
    <include app:graph="@navigation/saved_coupon_list_nav_graph" />
    <include app:graph="@navigation/crm_popup_nav_graph" />
</navigation>
