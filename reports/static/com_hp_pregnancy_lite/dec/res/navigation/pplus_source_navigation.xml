<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/pplus_source_navigation" app:startDestination="@id/fragment_with_progress_bar"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <action android:id="@id/action_set_email_as_root_navigation" app:destination="@id/email_verification_navigation">
        <argument android:name="type" app:argType="string" />
    </action>
    <action android:id="@id/action_set_mobile_navigation_as_root_navigation" app:destination="@id/main_navigation" />
    <action android:id="@id/action_set_login_screen_as_root_navigation" app:destination="@id/loginActivity" />
    <action android:id="@id/action_set_data_center_as_root_navigation" app:destination="@id/data_centre_status_nav_graph" />
    <fragment android:name="com.hp.pregnancy.util.navigation.FragmentWithProgressBar" android:id="@id/fragment_with_progress_bar" />
    <include app:graph="@navigation/mobile_navigation" />
    <include app:graph="@navigation/email_verification_navigation" />
    <include app:graph="@navigation/data_centre_status_nav_graph" />
    <activity android:label="LoginActivity" android:name="com.hp.pregnancy.lite.onboarding.LoginActivity" android:id="@id/loginActivity">
        <argument android:name="isFromResetLink" android:defaultValue="false" app:argType="boolean" />
    </activity>
</navigation>
