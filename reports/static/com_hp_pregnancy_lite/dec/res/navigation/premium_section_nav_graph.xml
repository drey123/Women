<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/navigation_premium" app:startDestination="@id/premiumFragment"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/expanded_series_nav_graph" />
    <include app:graph="@navigation/product_purchase_nav_graph" />
    <fragment android:label="@string/premium_fragment_label" android:name="com.hp.pregnancy.lite.premium.premiumfeed.PremiumScreenContainer" android:id="@id/premiumFragment">
        <action android:id="@id/action_premiumFragment_to_subscriptionPopupFragment" app:destination="@id/product_purchase_nav_graph" />
        <action android:id="@id/action_premiumFragment_to_expandedSeriesContainer" app:destination="@id/expanded_series_nav_graph">
            <argument android:name="seriesCMSId" app:argType="string" />
            <argument android:name="isFromPremiumScreen" app:argType="boolean" />
            <argument android:name="carouselTitle" app:argType="string" />
            <argument android:name="isPremium" app:argType="boolean" />
        </action>
        <deepLink android:id="@id/wallet_deeplink" app:uri="@string/wallet_deeplink_uri" />
    </fragment>
</navigation>
