<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/three_d_model_nav_graph" app:startDestination="@id/fetus3DFragment"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <fragment android:label="Fetus3DMainFragment" android:name="com.hp.pregnancy.fetus3d.Fetus3DFragment" android:id="@id/fetus3DFragment">
        <argument android:name="started_from" android:defaultValue="-1" app:argType="integer" />
        <argument android:name="pregnancy_week" android:defaultValue="-1" app:argType="integer" />
        <deepLink android:id="@id/three_d_fetus_deep_link" app:uri="@string/threeDFetus_deeplink_uri" />
        <action android:id="@id/action_fetus3DFragment_to_selectBabyFragment" app:destination="@id/selectBabyFragment" />
        <action android:id="@id/action_fetus3DFragment_to_video_player_nav_graph" app:destination="@id/video_player_nav_graph">
            <argument android:name="mediaUri" app:argType="string" />
            <argument android:name="shouldSendMuxAnalytics" app:argType="boolean" />
            <argument android:name="seriesId" app:argType="string" />
            <argument android:name="mediaData" app:argType="com.philips.hp.cms.model.premiumcontent.MediaCarouselItemContent" app:nullable="true" />
            <argument android:name="isFromPremiumScreen" app:argType="boolean" />
        </action>
    </fragment>
    <fragment android:label="SelectBabyFragment" android:name="com.hp.pregnancy.fetus3d.modelSelection.SelectBabyFragment" android:id="@id/selectBabyFragment">
        <argument android:name="startedFrom" android:defaultValue="-1" app:argType="integer" />
    </fragment>
    <include app:graph="@navigation/video_player_nav_graph" />
</navigation>
