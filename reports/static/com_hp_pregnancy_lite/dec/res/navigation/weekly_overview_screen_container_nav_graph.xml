<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/weekly_overview_screen_container" app:startDestination="@id/WeeklyOverviewScreenContainer"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/three_d_model_nav_graph" />
    <include app:graph="@navigation/select_3d_model_nav_graph" />
    <include app:graph="@navigation/size_guide_nav_graph" />
    <include app:graph="@navigation/video_player_nav_graph" />
    <fragment android:label="weeklyContentFragment" android:name="com.hp.pregnancy.lite.weekly.WeeklyOverviewScreenContainer" android:id="@id/WeeklyOverviewScreenContainer">
        <argument android:name="week" android:defaultValue="-1" app:argType="integer" />
        <argument android:name="cmsId" android:defaultValue="" app:argType="string" />
        <argument android:name="publishedVersion" android:defaultValue="" app:argType="string" />
        <deepLink android:id="@id/weekly_section_deeplink" app:uri="@string/weekly_deeplink_uri" />
        <action android:id="@id/action_weeklyOverview_container_to_three_d_model" app:destination="@id/three_d_model_nav_graph">
            <argument android:name="started_from" android:defaultValue="-1" app:argType="integer" />
            <argument android:name="pregnancy_week" android:defaultValue="-1" app:argType="integer" />
        </action>
        <action android:id="@id/action_weeklyOverview_container_to_select_3d_model_nav_graph" app:destination="@id/select_3d_model_nav_graph">
            <argument android:name="startedFrom" android:defaultValue="-1" app:argType="integer" />
        </action>
        <action android:id="@id/action_navigation_weeklyOverview_container_to_size_guide_nav_graph" app:destination="@id/size_guide_nav_graph">
            <argument android:name="pregnancy_week" android:defaultValue="-1" app:argType="integer" />
        </action>
        <action android:id="@id/action_weekly_container_to_expanded_article_nav_graph" app:destination="@id/expanded_article_nav_graph">
            <argument android:name="articleScreenArg" app:argType="com.philips.hp.cms.model.premiumcontent.ArticleScreenArg" app:nullable="false" />
        </action>
        <action android:id="@id/action_weekly_container_to_video_audio_player_container" app:destination="@id/video_player_nav_graph">
            <argument android:name="mediaUri" app:argType="string" />
            <argument android:name="shouldSendMuxAnalytics" app:argType="boolean" />
            <argument android:name="seriesId" app:argType="string" />
            <argument android:name="mediaData" app:argType="com.philips.hp.cms.model.premiumcontent.MediaCarouselItemContent" app:nullable="true" />
            <argument android:name="isFromPremiumScreen" app:argType="boolean" />
        </action>
        <action android:id="@id/action_weekly_container_to__gam_detail_sub_nav_graph" app:destination="@id/gam_detail_sub_nav_graph">
            <argument android:name="gamType" app:argType="string" app:nullable="true" />
        </action>
        <action android:id="@id/action_weekly_container_to__gam_carousel_nav_graph" app:destination="@id/gam_carousel_nav_graph" app:enterAnim="@android:anim/fade_in" app:exitAnim="@android:anim/fade_out">
            <argument android:name="ScreenTitle" app:argType="string" app:nullable="true" />
        </action>
        <action android:id="@id/action_weekly_container_to__expanded_ad_nav_graph" app:destination="@id/expanded_ad_nav_graph">
            <argument android:name="expandedCarouselModel" app:argType="com.philips.hp.components.dpads.models.carousel.ExpandedCarouselAdModel" app:nullable="true" />
        </action>
    </fragment>
</navigation>
