<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/hospital_bag_nav_graph" app:startDestination="@id/hospitalBagScreen"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/product_purchase_nav_graph" />
    <include app:graph="@navigation/upgrade_screen_nav_graph" />
    <fragment android:label="HospitalBagScreen" android:name="com.hp.pregnancy.lite.HospitalBag.HospitalBagScreen" android:id="@id/hospitalBagScreen">
        <argument android:name="bag" android:defaultValue="" app:argType="string" />
        <argument android:name="subsection" android:defaultValue="" app:argType="string" />
        <deepLink android:id="@id/hospitalbag_deep_link" app:uri="@string/hospitalBag_deeplink_uri" />
        <action android:id="@id/action_hospitalBagScreen_to_hospitalBagBaseScreen" app:destination="@id/hospitalBagBaseScreen">
            <argument android:name="selectedPosition" android:defaultValue="-1" app:argType="integer" />
            <argument android:name="packedCount" android:defaultValue="-1" app:argType="string" />
            <argument android:name="toolbarTitle" android:defaultValue="" app:argType="string" />
        </action>
    </fragment>
    <fragment android:label="HospitalBagBaseScreen" android:name="com.hp.pregnancy.lite.HospitalBag.HospitalBagBaseScreen" android:id="@id/hospitalBagBaseScreen">
        <argument android:name="selectedPosition" android:defaultValue="-1" app:argType="integer" />
        <argument android:name="packedCount" android:defaultValue="-1" app:argType="string" />
        <argument android:name="toolbarTitle" android:defaultValue="" app:argType="string" />
        <action android:id="@id/action_navigation_hospitalBagBaseScreen_to_upgradeScreen" app:destination="@id/upgrade_screen_nav_graph">
            <argument android:name="CallingActivity" android:defaultValue="" app:argType="string" />
            <argument android:name="IapSource" android:defaultValue="" app:argType="string" />
        </action>
        <action android:id="@id/action_hospitalBagBaseScreen_to_product_purchase_nav_graph" app:destination="@id/product_purchase_nav_graph" />
    </fragment>
</navigation>
