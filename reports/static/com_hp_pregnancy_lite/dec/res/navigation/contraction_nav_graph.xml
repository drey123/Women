<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/contraction_nav_graph" app:startDestination="@id/contractionsScreen"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/product_purchase_nav_graph" />
    <include app:graph="@navigation/upgrade_screen_nav_graph" />
    <fragment android:label="ContractionsScreen" android:name="com.hp.pregnancy.lite.more.contraction.ContractionsScreen" android:id="@id/contractionsScreen">
        <argument android:name="subsection" android:defaultValue="" app:argType="string" />
        <deepLink android:id="@id/contractions_deep_link" app:uri="@string/contractions_deeplink_uri" />
        <action android:id="@id/action_navigation_contraction_screen_to_upgrade" app:destination="@id/upgrade_screen_nav_graph">
            <argument android:name="CallingActivity" android:defaultValue="" app:argType="string" />
            <argument android:name="IapSource" android:defaultValue="" app:argType="string" />
        </action>
        <action android:id="@id/action_contractionsScreen_to_product_purchase_nav_graph" app:destination="@id/product_purchase_nav_graph" />
    </fragment>
</navigation>
