<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/baby_names_nav_graph" app:startDestination="@id/babyNameBaseScreen"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <fragment android:label="BabyNameBaseScreen" android:name="com.hp.pregnancy.lite.more.babynames.BabyNameBaseScreen" android:id="@id/babyNameBaseScreen">
        <argument android:name="tabIndex" android:defaultValue="-1" app:argType="integer" />
        <argument android:name="subsection" android:defaultValue="" app:argType="string" />
        <argument android:name="gender" android:defaultValue="" app:argType="string" />
        <argument android:name="nation" android:defaultValue="" app:argType="string" />
        <argument android:name="ordering" android:defaultValue="" app:argType="string" />
        <deepLink android:id="@id/baby_names_deep_links" app:uri="@string/babyNames_deeplink_uri" />
        <action android:id="@id/action_babyNameBaseScreen_to_countrySpecificNameScreen" app:destination="@id/countrySpecificNameScreen">
            <argument android:name="selectedCountry" android:defaultValue="" app:argType="string" />
            <argument android:name="toolbarTitle" android:defaultValue="" app:argType="string" />
            <argument android:name="babySex" android:defaultValue="" app:argType="string" />
            <argument android:name="ordering" android:defaultValue="" app:argType="string" />
        </action>
    </fragment>
    <fragment android:label="CountrySpecificNameScreen" android:name="com.hp.pregnancy.lite.more.babynames.CountrySpecificNameScreen" android:id="@id/countrySpecificNameScreen">
        <argument android:name="selectedCountry" android:defaultValue="" app:argType="string" />
        <argument android:name="toolbarTitle" android:defaultValue="" app:argType="string" />
        <argument android:name="babySex" android:defaultValue="" app:argType="string" />
        <argument android:name="ordering" android:defaultValue="" app:argType="string" />
    </fragment>
</navigation>
