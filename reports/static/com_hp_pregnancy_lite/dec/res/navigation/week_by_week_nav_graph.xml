<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/week_by_week_nav_graph" app:startDestination="@id/week_by_week_container"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <fragment android:label="WeekByWeekContainer" android:name="com.hp.pregnancy.lite.discover.WeekByWeekContainer" android:id="@id/week_by_week_container">
        <argument android:name="weeklyCMSId" android:defaultValue="" app:argType="string" />
        <argument android:name="seriesCMSId" android:defaultValue="" app:argType="string" />
        <action android:id="@id/action_week_by_week_container_to_subscriptionPopupFragment" app:destination="@id/product_purchase_nav_graph" />
        <action android:id="@id/action_week_by_week_container_to_expanded_article_nav_graph" app:destination="@id/expanded_article_nav_graph">
            <argument android:name="articleScreenArg" app:argType="com.philips.hp.cms.model.premiumcontent.ArticleScreenArg" app:nullable="false" />
        </action>
        <action android:id="@id/action_week_by_week_container_to_video_player_nav_graph" app:destination="@id/video_player_nav_graph">
            <argument android:name="mediaUri" app:argType="string" />
            <argument android:name="shouldSendMuxAnalytics" app:argType="boolean" />
            <argument android:name="seriesId" app:argType="string" />
            <argument android:name="mediaData" app:argType="com.philips.hp.cms.model.premiumcontent.MediaCarouselItemContent" app:nullable="true" />
            <argument android:name="isFromPremiumScreen" app:argType="boolean" />
        </action>
    </fragment>
    <include app:graph="@navigation/expanded_article_nav_graph" />
    <include app:graph="@navigation/product_purchase_nav_graph" />
    <include app:graph="@navigation/video_player_nav_graph" />
</navigation>
