<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/navigation_settings" app:startDestination="@id/settings"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <fragment android:name="com.stardust.app.presentation.settings.SettingsFragment" android:id="@id/settings">
        <action android:id="@id/action_username" app:destination="@id/username" />
        <action android:id="@id/action_birthdate" app:destination="@id/birthdate" />
        <action android:id="@id/action_cycle_length" app:destination="@id/cycle_length" />
        <action android:id="@id/action_period_length" app:destination="@id/period_length" />
        <action android:id="@id/action_ovulation_day" app:destination="@id/ovulation_day" />
        <action android:id="@id/action_birth_control_method" app:destination="@id/birth_control_method" />
        <action android:id="@id/action_notification_settings" app:destination="@id/notification_settings" />
        <action android:id="@id/action_usage_purpose" app:destination="@id/usage_purpose" />
        <action android:id="@id/action_health_conditions" app:destination="@id/health_conditions" />
        <action android:id="@id/action_partners" app:destination="@id/partners" />
        <action android:id="@id/action_settingsFragment_to_manageSubscriptionFragment" app:destination="@id/manageSubscriptionFragment" />
        <action android:id="@id/action_settingsFragment_to_blockedUsersFragment" app:destination="@id/blockedUsersFragment" />
        <action android:id="@id/action_update_due_date" app:destination="@id/settings_update_due_date" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.username.UsernameFragment" android:id="@id/username">
        <argument android:name="flowType" android:defaultValue="SETTINGS" app:argType="com.stardust.app.presentation.settings.FlowType" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.cyclelength.CycleLengthFragment" android:id="@id/cycle_length">
        <argument android:name="flowType" android:defaultValue="SETTINGS" app:argType="com.stardust.app.presentation.settings.FlowType" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.periodlength.PeriodLengthFragment" android:id="@id/period_length">
        <argument android:name="flowType" android:defaultValue="SETTINGS" app:argType="com.stardust.app.presentation.settings.FlowType" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.ovulationday.OvulationDayFragment" android:id="@id/ovulation_day" />
    <fragment android:name="com.stardust.app.presentation.settings.birthcontrolmethod.BirthControlMethodFragment" android:id="@id/birth_control_method">
        <argument android:name="flowType" android:defaultValue="SETTINGS" app:argType="com.stardust.app.presentation.settings.FlowType" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.notificationsettings.NotificationSettingsFragment" android:id="@id/notification_settings" />
    <fragment android:name="com.stardust.app.presentation.settings.usagepurpose.UsagePurposeFragment" android:id="@id/usage_purpose">
        <argument android:name="flowType" android:defaultValue="SETTINGS" app:argType="com.stardust.app.presentation.settings.FlowType" />
        <action android:id="@id/action_birthdate" app:destination="@id/birthdate" />
        <action android:id="@id/action_pregnancy_intro" app:destination="@id/pregnancy_intro" />
        <action android:id="@id/action_enter_partner_code" app:destination="@id/partner_code" />
        <action android:id="@id/action_pregnancy_update_due_date" app:destination="@id/pregnancy_update_due_date" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.partner.PartnerCodeFragment" android:id="@id/partner_code">
        <argument android:name="flowType" android:defaultValue="ON_BOARDING" app:argType="com.stardust.app.presentation.settings.FlowType" />
        <action android:id="@id/action_partner_code_info" app:destination="@id/partnerCodeInfoFragment" />
        <action android:id="@id/action_partner_success" app:destination="@id/partner_success" />
        <action android:id="@id/action_to_notification_permission" app:destination="@id/notification_permission" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.pregnancy.intro.PregnancyIntroFragment" android:id="@id/pregnancy_intro">
        <argument android:name="flowType" app:argType="com.stardust.app.presentation.settings.FlowType" />
        <action android:id="@id/action_pregnancy_last_period" app:destination="@id/pregnancy_last_period" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.pregnancy.lastperiod.PregnancyLastPeriodFragment" android:id="@id/pregnancy_last_period">
        <argument android:name="flowType" app:argType="com.stardust.app.presentation.settings.FlowType" />
        <action android:id="@id/action_pregnancy_update_due_date" app:destination="@id/pregnancy_update_due_date" />
        <action android:id="@id/action_pregnancy_explore_creator_mode" app:destination="@id/pregnancy_explore_creator_mode" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.pregnancy.duedate.UpdateDueDateFragment" android:id="@id/pregnancy_update_due_date">
        <argument android:name="flowType" app:argType="com.stardust.app.presentation.settings.FlowType" />
        <argument android:name="currentDate" app:argType="java.util.Date" />
        <argument android:name="updateDueDateAfterReactivation" app:argType="boolean" />
        <action android:id="@id/action_pregnancy_explore_creator_mode" app:destination="@id/pregnancy_explore_creator_mode" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.pregnancy.explorecreatormode.ExploreCreatorModeFragment" android:id="@id/pregnancy_explore_creator_mode">
        <argument android:name="flowType" app:argType="com.stardust.app.presentation.settings.FlowType" />
        <argument android:name="lastPeriodDate" app:argType="java.util.Date" />
        <argument android:name="dueDate" app:argType="java.util.Date" />
        <action android:id="@id/action_birthdate" app:destination="@id/birthdate" />
        <action android:id="@id/action_pregnancy_update_due_date" app:destination="@id/pregnancy_update_due_date" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.birthdate.BirthdateFragment" android:id="@id/birthdate">
        <argument android:name="flowType" app:argType="com.stardust.app.presentation.settings.FlowType" />
        <action android:id="@id/action_period_data_sources" app:destination="@id/period_data_sources" />
        <action android:id="@id/action_manual_period_input" app:destination="@id/manual_period_input" />
        <action android:id="@id/action_notification_permission" app:destination="@id/notification_permission" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.partner.PartnersFragment" android:id="@id/partners">
        <action android:id="@id/action_partner_code" app:destination="@id/navigation_partner" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.managesubscription.ManageSubscriptionFragment" android:id="@id/manageSubscriptionFragment" />
    <fragment android:name="com.stardust.app.presentation.settings.blockedusers.BlockedUsersFragment" android:id="@id/blockedUsersFragment" />
    <include app:graph="@navigation/nav_graph_partner" />
    <fragment android:name="com.stardust.app.presentation.settings.healthconditions.HealthConditionsFragment" android:id="@id/health_conditions">
        <argument android:name="flowType" android:defaultValue="SETTINGS" app:argType="com.stardust.app.presentation.settings.FlowType" />
    </fragment>
    <fragment android:name="com.stardust.app.presentation.settings.pregnancy.duedate.UpdateDueDateFragment" android:id="@id/settings_update_due_date">
        <argument android:name="flowType" app:argType="com.stardust.app.presentation.settings.FlowType" />
        <argument android:name="currentDate" app:argType="java.util.Date" />
        <argument android:name="updateDueDateAfterReactivation" app:argType="boolean" />
        <action android:id="@id/action_pregnancy_explore_creator_mode" app:destination="@id/pregnancy_explore_creator_mode" />
    </fragment>
</navigation>
