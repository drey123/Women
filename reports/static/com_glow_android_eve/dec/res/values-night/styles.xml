<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.SplashScreen.DayNight" parent="@style/Base.Theme.SplashScreen" />
    <style name="Theme.MaterialComponents.DayNight.Bridge" parent="@style/Theme.MaterialComponents.Bridge" />
    <style name="Theme.Winter" parent="@style/Theme.MaterialComponents.DayNight.Bridge">
        <item name="android:colorBackground">@color/dark_color_window_background</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:windowBackground">@color/dark_color_window_background</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="actionBarStyle">@style/WinterActionBar</item>
        <item name="actionMenuTextColor">@color/primary_text_disable_only_material_light</item>
        <item name="appBarLayoutStyle">@style/WinterAppLayout</item>
        <item name="colorAccent">@color/purple</item>
        <item name="colorControlNormal">?android:textColorPrimary</item>
        <item name="colorPrimary">@color/dark_color_primary</item>
        <item name="colorPrimaryDark">@color/dark_color_primary_dark</item>
        <item name="colorSecondary">@color/dark_color_secondary</item>
    </style>
</resources>
