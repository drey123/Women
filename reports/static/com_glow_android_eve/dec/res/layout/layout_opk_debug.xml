<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@color/black" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.camera.view.PreviewView android:id="@id/camera_preview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@id/image_view_src" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="center" />
    <LinearLayout android:orientation="vertical" android:background="#a0333333" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView android:layout_gravity="end" android:id="@id/button_start_camera" android:padding="16.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@null" />
            <androidx.appcompat.widget.AppCompatImageView android:layout_gravity="end" android:id="@id/button_choose" android:padding="20.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/ic_switch_to_images" android:tint="@color/white" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView android:id="@id/image_view_strip" android:layout_width="match_parent" android:layout_height="wrap_content" android:scaleType="fitXY" />
        <androidx.appcompat.widget.AppCompatImageView android:id="@id/image_view_strip_debug" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8.0dp" android:scaleType="fitXY" />
        <androidx.appcompat.widget.AppCompatTextView android:textColor="@color/white" android:id="@id/text_result" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:layout_gravity="bottom" android:orientation="vertical" android:background="#a0333333" android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView android:textColor="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8.0dp" android:text="Strip" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="8.0dp">
            <com.google.android.material.checkbox.MaterialCheckBox android:textColor="@color/white" android:id="@id/checkbox_show_thresh" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="Show thresh" android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
