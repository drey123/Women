<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="@string/help_section_help_caption" style="@style/ProfileCardCaption" />
        <View android:background="@color/profile_line_color" android:layout_width="match_parent" android:layout_height="0.5dp" />
        <LinearLayout android:orientation="vertical" android:layout_height="wrap_content" style="@style/ProfileCard">
            <TextView android:id="@id/faq" android:text="@string/help_faq" android:fontFamily="sans-serif-light" style="@style/HelpItem" />
        </LinearLayout>
        <TextView android:text="@string/help_section_connect_caption" style="@style/ProfileCardCaption" />
        <View android:background="@color/profile_line_color" android:layout_width="match_parent" android:layout_height="0.5dp" />
        <LinearLayout android:orientation="vertical" android:layout_height="wrap_content" style="@style/ProfileCard">
            <TextView android:id="@id/web" android:text="@string/help_web" android:fontFamily="sans-serif-light" style="@style/HelpItem" />
            <TextView android:id="@id/blog" android:text="@string/help_blog" android:fontFamily="sans-serif-light" style="@style/HelpItem" />
            <TextView android:id="@id/facebook" android:text="@string/help_facebook" android:fontFamily="sans-serif-light" style="@style/HelpItem" />
            <TextView android:id="@id/twitter" android:text="@string/help_twitter" android:fontFamily="sans-serif-light" style="@style/HelpItem" />
        </LinearLayout>
        <TextView android:text="@string/help_section_terms_caption" style="@style/ProfileCardCaption" />
        <View android:background="@color/profile_line_color" android:layout_width="match_parent" android:layout_height="0.5dp" />
        <LinearLayout android:orientation="vertical" android:layout_height="wrap_content" style="@style/ProfileCard">
            <TextView android:id="@id/tos" android:text="@string/help_tos" android:fontFamily="sans-serif-light" style="@style/HelpItem" />
            <TextView android:id="@id/privacy" android:text="@string/help_privacy" android:fontFamily="sans-serif-light" style="@style/HelpItem" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
