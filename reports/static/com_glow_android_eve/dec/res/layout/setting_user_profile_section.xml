<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView android:text="@string/setting_section_account_title" style="@style/SettingSectionTitle" />
    <RelativeLayout android:id="@id/profile_photo_container" android:paddingTop="8.0dp" android:paddingBottom="8.0dp" style="@style/UserProfileItem">
