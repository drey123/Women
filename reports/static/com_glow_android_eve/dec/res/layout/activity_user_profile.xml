<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="@color/white" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:id="@id/profile_photo_container" android:paddingTop="8.0dp" android:paddingBottom="8.0dp" style="@style/UserProfileItem">
            <ImageView android:id="@id/profile_photo" android:layout_width="40.0dp" android:layout_height="40.0dp" android:src="@drawable/ic_default_user_photo" android:layout_centerVertical="true" />
            <TextView android:layout_marginLeft="16.0dp" android:layout_marginRight="48.0dp" android:text="@string/activity_user_profile_update_profile_photo" android:layout_toRightOf="@id/profile_photo" android:layout_centerVertical="true" style="@style/UserProfileItemTitle" />
        </RelativeLayout>
        <View style="@style/UserProfileDivider" />
