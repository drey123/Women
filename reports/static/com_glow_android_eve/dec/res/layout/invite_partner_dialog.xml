        <LinearLayout android:orientation="vertical" android:padding="24.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/image">
            <TextView android:textSize="20.0sp" android:textColor="@android:color/black" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/invite_partner_dialog_title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20.0dp" android:text="@string/invite_partner_dialog_text" android:lineSpacingMultiplier="1.1" />
