            <EditText android:id="@id/partner_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4.0dp" android:hint="@string/invite_partner_dialog_partner_email" android:maxLines="1" android:inputType="textEmailAddress" />
            <TextView android:textSize="12.0sp" android:id="@id/partner_feature_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4.0dp" android:lineSpacingMultiplier="1.1" />
        </LinearLayout>
