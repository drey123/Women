<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/calendar_help" android:background="@color/transparent_color" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include android:id="@id/activity_title_layout_view" android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/activity_title_layout" />
    <TextView android:textSize="@dimen/dp_size_phone_18_tablet_25" android:textColor="#ffffff" android:gravity="center" android:id="@id/cal_info_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/dp_size_phone_5_tablet_10" android:text="@string/HomePageHelp" android:layout_above="@id/arrow" android:layout_centerHorizontal="true" android:layout_marginStart="@dimen/dp_size_phone_70_tablet_200" android:layout_marginEnd="@dimen/dp_size_phone_70_tablet_200" />
    <RelativeLayout android:id="@id/bottom_layout" android:background="@drawable/rounded_rectangle_small" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true">
        <ImageButton android:id="@id/image_arrow" android:background="@drawable/arrow_collapse_calendar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_size_phone_10_tablet_20" android:layout_centerHorizontal="true" android:contentDescription="@string/ImageAccessibilityText" />
        <TextView android:textSize="@dimen/dp_size_phone_20_tablet_25" android:textColor="@color/page_text_color" android:id="@id/text_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_size_phone_10_tablet_20" android:layout_marginStart="@dimen/dp_size_phone_20_tablet_25" android:layout_toStartOf="@id/doodle_calendar" />
        <TextView android:textSize="@dimen/dp_size_phone_15_tablet_20" android:textColor="@color/page_text_color" android:id="@id/txt_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_size_phone_5_tablet_10" android:text="@string/ProgressText" android:layout_below="@id/text_date" android:layout_marginStart="@dimen/dp_size_phone_20_tablet_25" android:layout_alignParentStart="true" />
        <TextView android:textSize="@dimen/dp_size_phone_15_tablet_20" android:textColor="#e89192" android:gravity="center_vertical" android:id="@id/txt_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_size_phone_10_tablet_20" android:text="@string/CycleStageUnsafe" android:layout_below="@id/txt_progress" android:layout_marginStart="@dimen/dp_size_phone_15_tablet_20" android:layout_alignParentStart="true" />
        <ImageView android:id="@id/doodle_calendar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_size_phone_5_tablet_10" android:src="@drawable/doodle_dola" android:contentDescription="@string/ImageAccessibilityText" android:layout_marginEnd="@dimen/dp_size_phone_15_tablet_20" android:layout_alignParentEnd="true" />
    </RelativeLayout>
    <ImageView android:id="@id/arrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/arrows_help" android:layout_above="@id/bottom_layout" android:layout_centerHorizontal="true" android:contentDescription="@string/ImageAccessibilityText" />
</RelativeLayout>
