<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/rlForumCreateTopicPage" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
