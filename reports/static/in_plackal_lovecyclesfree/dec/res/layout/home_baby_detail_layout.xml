<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:id="@id/home_baby_detail_layout" android:background="#599c86d0" android:paddingTop="@dimen/dp_size_phone_15_tablet_25" android:paddingBottom="@dimen/dp_size_phone_15_tablet_25" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@id/home_baby_detail_image_view" android:background="@drawable/icn_baby_big_selector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/ImageAccessibilityText" android:layout_marginStart="@dimen/dp_size_phone_10_tablet_15" android:layout_alignParentStart="true" />
        <TextView android:textSize="@dimen/dp_size_phone_15_tablet_22" android:textColor="@color/page_text_color" android:id="@id/home_baby_detail_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/BabyArrivedWithoutQuestionMark" android:layout_centerVertical="true" android:layout_marginStart="@dimen/dp_size_phone_20_tablet_30" android:layout_toEndOf="@id/home_baby_detail_image_view" />
        <LinearLayout android:orientation="horizontal" android:id="@id/home_baby_detail_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_size_phone_20_tablet_30" android:layout_marginEnd="@dimen/dp_size_phone_10_tablet_15" android:layout_toEndOf="@id/home_baby_detail_image_view" />
        <TextView android:textSize="@dimen/dp_size_phone_15_tablet_22" android:textColor="@color/page_text_color" android:ellipsize="end" android:id="@id/home_baby_notes_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:layout_below="@id/home_baby_detail_container" android:layout_centerVertical="true" android:layout_marginStart="@dimen/dp_size_phone_20_tablet_30" android:layout_marginEnd="@dimen/dp_size_phone_20_tablet_30" android:layout_toEndOf="@id/home_baby_detail_image_view" />
    </RelativeLayout>
</RelativeLayout>
